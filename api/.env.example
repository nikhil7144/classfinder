# The same Supabase project the web app uses. RLS still enforces every rule;
# this service adds a contract, validation and tests on top of it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Port the API listens on. The web app and the Flutter app both talk to this.
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
# In production this must list the deployed site's origin, or the browser
# blocks every call. The Flutter app is unaffected — CORS is a browser rule.
CORS_ORIGINS=http://localhost:3000

# The model key, for the suggestion endpoints.
GOOGLE_API_KEY=your-google-api-key

# Slack incoming webhook, for telling the team when a coach or a family
# finishes registering. Optional: leave it unset and the alerts quietly do
# nothing, which is how development and the tests run.
#
# It is a secret — anyone holding it can post into the channel — so it belongs
# in the host's environment, never in the repo.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Push notifications (phase3w)
#
# Only the worker at POST /api/v1/notify/dispatch reads any of these. Leave
# them unset and that endpoint refuses rather than half-sending, the rest of
# the API is unaffected, and the tests and local development are unchanged.
# ---------------------------------------------------------------------

# The service role key, used by the push worker and nothing else — it is the
# one place in this service that acts as nobody in particular, because it
# drains a queue on behalf of every user. Kept out of SupabaseService on
# purpose: see supabase-admin.service.ts.
#
# This key bypasses every RLS policy in db/. It belongs in the host's
# environment and must never reach a client, a log line or this repo.
SUPABASE_SERVICE_ROLE_KEY=

# A Firebase service account with the Cloud Messaging role, as the JSON
# Google's console downloads. Either the raw JSON or its base64 — the second
# is offered because a PEM key with newlines survives pasting into roughly
# half the hosting dashboards in use.
#
# iOS is reached through Firebase rather than APNs directly, so the APNs key
# is uploaded in the Firebase console and there is nothing more to set here.
FIREBASE_SERVICE_ACCOUNT=

# Shared with whatever calls the worker on a schedule. The same secret the
# web app's email dispatcher uses, so one scheduler configuration covers both
# legs. Unset means the endpoint refuses every call, which is the safe way for
# a misconfigured deploy to fail.
NOTIFICATION_DISPATCH_SECRET=
