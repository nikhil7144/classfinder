# The same Supabase project the web app uses. RLS still enforces every rule;
# this service adds a contract, validation and tests on top of it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Port the API listens on. The web app and the Flutter app both talk to this.
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
# In production this must list the deployed site's origin, or the browser
# blocks every call. The Flutter app is unaffected — CORS is a browser rule.
CORS_ORIGINS=http://localhost:3000

# The model key, for the suggestion endpoints.
GOOGLE_API_KEY=your-google-api-key

# Slack incoming webhook, for telling the team when a coach or a family
# finishes registering. Optional: leave it unset and the alerts quietly do
# nothing, which is how development and the tests run.
#
# It is a secret — anyone holding it can post into the channel — so it belongs
# in the host's environment, never in the repo.
SLACK_WEBHOOK_URL=
