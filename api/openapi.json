{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "uptimeSeconds": {
                      "type": "number",
                      "example": 1234
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness — the process is up and serving",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/feeds/cities": {
      "get": {
        "description": "Only cities with a live area and at least one approved coach in it, busiest first. The head of this list is the sensible default for a visitor who has not chosen.",
        "operationId": "FeedsController_cities_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CityDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Cities open for browsing",
        "tags": [
          "feeds"
        ]
      }
    },
    "/api/v1/feeds/cities/{cityId}": {
      "get": {
        "description": "Readable signed out. Posts appear here a few hours after they are written, because hiding a reported post needs signed-in reporters and a guest cannot report at all.",
        "operationId": "FeedsController_cityFeed_v1",
        "parameters": [
          {
            "name": "cityId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 60,
              "default": 24,
              "type": "number"
            }
          },
          {
            "name": "before",
            "required": false,
            "in": "query",
            "description": "Return posts older than this. Pass the createdAt of the last post you have.",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedPostDto"
                  }
                }
              }
            }
          }
        },
        "summary": "What coaches in a city have been posting",
        "tags": [
          "feeds"
        ]
      }
    },
    "/api/v1/feeds/me": {
      "get": {
        "description": "Posts from coaches they follow, plus coaches in their city teaching what they said they are looking for. Each post carries a `reason` saying which of the two it is.",
        "operationId": "FeedsController_myFeed_v1",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 60,
              "default": 24,
              "type": "number"
            }
          },
          {
            "name": "before",
            "required": false,
            "in": "query",
            "description": "Return posts older than this. Pass the createdAt of the last post you have.",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FeedPostDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's own feed",
        "tags": [
          "feeds"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The first call after signing in. `role: null` means a verified account that has not chosen a role yet — send them to pick one; it is not an error. The seeker or provider block is present only for that role.",
        "operationId": "MeController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Who is asking, and what they have finished",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/organisers/me": {
      "get": {
        "description": "Null before they have created one — a normal state for an account that has picked the role and not filled the form in yet, not an error. Visible while unapproved, so a company waiting on an admin can see what it submitted.",
        "operationId": "OrganisersController_mine_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Null when no listing exists yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganiserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's own organiser listing",
        "tags": [
          "organisers"
        ]
      },
      "put": {
        "description": "One listing per account, so this upserts. Approval and suspension are absent from the body by design and withheld by column privileges besides — naming either is refused by Postgres, not just by this contract.",
        "operationId": "OrganisersController_save_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrganiserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganiserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create or update it",
        "tags": [
          "organisers"
        ]
      }
    },
    "/api/v1/queries": {
      "get": {
        "description": "A coach gets the ones raised with them, a parent gets their own. One endpoint for both sides — the row policy decides which rows those are, so neither has to say who it is.",
        "operationId": "QueriesController_list_v1",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "new",
                "contacted",
                "callback_scheduled",
                "completed",
                "closed"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QueryDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Queries the caller is party to",
        "tags": [
          "queries"
        ]
      },
      "post": {
        "description": "One live query per coach — asking twice returns 400 rather than making a second lead. Needs a completed seeker profile and an approved coach, both enforced by the row policy.",
        "operationId": "QueriesController_raise_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RaiseQueryDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ask a coach to get in touch",
        "tags": [
          "queries"
        ]
      }
    },
    "/api/v1/queries/{id}/status": {
      "patch": {
        "description": "The coach's own queries only. callbackAt is required for callback_scheduled.",
        "operationId": "QueriesController_setStatus_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateQueryStatusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Move a lead along",
        "tags": [
          "queries"
        ]
      }
    },
    "/api/v1/queries/{id}/answer": {
      "post": {
        "description": "Returns the enquiry to open. If a thread with this family already exists the message lands there instead of starting a second one, and the query is attached to it either way.",
        "operationId": "QueriesController_answer_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerQueryDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnsweredQueryDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reply in writing, opening a conversation",
        "tags": [
          "queries"
        ]
      }
    },
    "/api/v1/queries/{id}/read": {
      "post": {
        "operationId": "QueriesController_markRead_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mark it read, for whichever side is asking",
        "tags": [
          "queries"
        ]
      }
    },
    "/api/v1/reference": {
      "get": {
        "description": "Public and cached for a few minutes. Fetch once at startup and keep it — these change only when an admin edits the taxonomy or opens an area. Areas are returned whole, with `isLive` alongside: it gates seekers, not providers, so it is a flag and not a filter.",
        "operationId": "ReferenceController_all_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceDto"
                }
              }
            }
          }
        },
        "summary": "Cities, areas and the taxonomy, in one call",
        "tags": [
          "reference"
        ]
      }
    },
    "/api/v1/suggestions/coaches": {
      "post": {
        "description": "For a signed-in parent with a stated requirement. search_providers() decides who is eligible; the model only orders them and says why. Answers are cached against a fingerprint of the requirement and the candidate set, so a second look is free until one of them changes. Always returns a list where one exists — `ranked: false` means it is in plain distance order, not that anything failed.",
        "operationId": "SuggestionsController_coaches_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachSuggestionsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Coaches worth looking at first",
        "tags": [
          "suggestions"
        ]
      }
    },
    "/api/v1/suggestions/students": {
      "post": {
        "description": "The same idea pointed the other way, over the coach's demand feed. Not cached: unlike the parent's, this one is asked for deliberately rather than rendered on arrival.",
        "operationId": "SuggestionsController_students_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentSuggestionsQueryDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentSuggestionsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Families worth a coach's attention first",
        "tags": [
          "suggestions"
        ]
      }
    }
  },
  "info": {
    "title": "ClassFinder API",
    "description": "The contract the web app and the Flutter app both speak.\n\nEvery request runs against Postgres as the caller, so the row-level security policies in `db/` remain the last word on who may see what. This API adds the contract, the validation and the tests; it does not replace those rules.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "feeds",
      "description": "What coaches have been posting, publicly and per parent"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "The Supabase access token, exactly as the client SDK issues it."
      }
    },
    "schemas": {
      "CityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Indore"
          },
          "state": {
            "type": "string",
            "nullable": true,
            "example": "Madhya Pradesh"
          },
          "coachCount": {
            "type": "number",
            "description": "Approved coaches serving a live area of this city."
          }
        },
        "required": [
          "id",
          "name",
          "state",
          "coachCount"
        ]
      },
      "FeedPostDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "providerId": {
            "type": "string",
            "format": "uuid",
            "description": "The coach who wrote it."
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          },
          "categoryName": {
            "type": "string",
            "nullable": true,
            "example": "Sports Academy"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "Set when kind is photo."
          },
          "youtubeId": {
            "type": "string",
            "nullable": true,
            "description": "The 11-character YouTube id. Set when kind is video.",
            "example": "dQw4w9WgXcQ"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "likes": {
            "type": "number",
            "description": "Total, across everyone."
          },
          "wows": {
            "type": "number"
          },
          "surprises": {
            "type": "number"
          },
          "myReaction": {
            "type": "string",
            "enum": [
              "like",
              "wow",
              "surprise"
            ],
            "nullable": true,
            "description": "This caller's own reaction. Absent on the public feed, which has no caller."
          },
          "iReported": {
            "type": "boolean",
            "description": "Whether this caller has already reported it."
          },
          "reason": {
            "type": "string",
            "enum": [
              "following",
              "interest"
            ],
            "description": "Why this post is in the feed. 'following' means the caller follows this coach; 'interest' means we suggested them. Absent on the public feed."
          }
        },
        "required": [
          "id",
          "providerId",
          "displayName",
          "photoUrl",
          "categoryName",
          "kind",
          "body",
          "imageUrl",
          "youtubeId",
          "createdAt",
          "likes",
          "wows",
          "surprises"
        ]
      },
      "MeSeekerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          },
          "areaId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "lookingFor": {
            "description": "Service category ids they said they are looking for. Empty until they say.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "openToOffers": {
            "type": "boolean",
            "description": "Whether coaches may approach them."
          }
        },
        "required": [
          "name",
          "photoUrl",
          "areaId",
          "lookingFor",
          "openToOffers"
        ]
      },
      "MeProviderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The listing id, which is not the user id."
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          },
          "providerType": {
            "type": "string",
            "enum": [
              "individual",
              "institution",
              "event_planner"
            ]
          },
          "approved": {
            "type": "boolean",
            "description": "Visible in search. False means waiting on an admin."
          },
          "isSuspended": {
            "type": "boolean",
            "description": "Taken down. Different from never approved, and says so."
          }
        },
        "required": [
          "id",
          "displayName",
          "photoUrl",
          "providerType",
          "approved",
          "isSuspended"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "nullable": true,
            "enum": [
              "seeker",
              "provider",
              "admin"
            ],
            "description": "Null when the account exists but no role has been chosen."
          },
          "profileComplete": {
            "type": "boolean",
            "description": "Whether they finished the profile their role requires."
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "seeker": {
            "nullable": true,
            "description": "Present only for a seeker. Null when the role is set but the row is not.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeSeekerDto"
              }
            ]
          },
          "provider": {
            "nullable": true,
            "description": "Present only for a provider.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MeProviderDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "profileComplete",
          "phone"
        ]
      },
      "OrganiserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "about": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "contactEmail": {
            "type": "string",
            "nullable": true
          },
          "contactPhone": {
            "type": "string",
            "nullable": true
          },
          "websiteUrl": {
            "type": "string",
            "nullable": true
          },
          "areaId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "venueName": {
            "type": "string",
            "nullable": true
          },
          "venueAddress": {
            "type": "string",
            "nullable": true
          },
          "approved": {
            "type": "boolean",
            "description": "Visible publicly. False means waiting on an admin."
          },
          "isSuspended": {
            "type": "boolean",
            "description": "Taken down. Different from never approved, and says so."
          }
        },
        "required": [
          "id",
          "name",
          "about",
          "logoUrl",
          "contactEmail",
          "contactPhone",
          "websiteUrl",
          "areaId",
          "venueName",
          "venueAddress",
          "approved",
          "isSuspended"
        ]
      },
      "UpdateOrganiserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "about": {
            "type": "string",
            "maxLength": 2000
          },
          "logoUrl": {
            "type": "string",
            "format": "uri"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "contactPhone": {
            "type": "string",
            "example": "9876543210"
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri"
          },
          "areaId": {
            "type": "string",
            "format": "uuid"
          },
          "venueName": {
            "type": "string",
            "maxLength": 120
          },
          "venueAddress": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "QueryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "providerId": {
            "type": "string",
            "format": "uuid"
          },
          "providerName": {
            "type": "string",
            "nullable": true,
            "description": "The coach's name, for the parent's list."
          },
          "seekerId": {
            "type": "string",
            "format": "uuid"
          },
          "contactName": {
            "type": "string",
            "description": "As given when the query was raised, not as the profile reads now."
          },
          "contactPhone": {
            "type": "string",
            "description": "Only ever visible to the two parties."
          },
          "serviceCategoryId": {
            "type": "string",
            "nullable": true,
            "format": "uuid"
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "callback_scheduled",
              "completed",
              "closed"
            ]
          },
          "callbackAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "respondedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "enquiryId": {
            "type": "string",
            "nullable": true,
            "format": "uuid",
            "description": "The conversation this query produced, once one exists."
          }
        },
        "required": [
          "id",
          "providerId",
          "providerName",
          "seekerId",
          "contactName",
          "contactPhone",
          "serviceCategoryId",
          "serviceName",
          "details",
          "status",
          "callbackAt",
          "createdAt",
          "respondedAt",
          "enquiryId"
        ]
      },
      "RaiseQueryDto": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "format": "uuid",
            "description": "The coach being asked. Must be approved."
          },
          "contactName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "contactPhone": {
            "type": "string",
            "example": "+91 98765 43210",
            "description": "Required, unlike on an enquiry. The point of a query is to be called, so one without a number is a request nobody can act on. Prefilled from the profile and editable, so a second number can be used without changing the account."
          },
          "serviceCategoryId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "providerId",
          "contactName",
          "contactPhone"
        ]
      },
      "UpdateQueryStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "callback_scheduled",
              "completed",
              "closed"
            ]
          },
          "callbackAt": {
            "type": "string",
            "format": "date-time",
            "description": "Required when status is callback_scheduled, ignored otherwise."
          }
        },
        "required": [
          "status"
        ]
      },
      "AnswerQueryDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "message"
        ]
      },
      "AnsweredQueryDto": {
        "type": "object",
        "properties": {
          "enquiryId": {
            "type": "string",
            "format": "uuid",
            "description": "The conversation to open. An existing thread with this family if there was one, so a parent never ends up with two conversations for one coach."
          }
        },
        "required": [
          "enquiryId"
        ]
      },
      "CityRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Indore"
          },
          "state": {
            "type": "string",
            "nullable": true,
            "example": "Madhya Pradesh"
          }
        },
        "required": [
          "id",
          "name",
          "state"
        ]
      },
      "AreaRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cityId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Vijay Nagar"
          },
          "lat": {
            "type": "number",
            "nullable": true,
            "description": "Centroid, the fallback search origin."
          },
          "lng": {
            "type": "number",
            "nullable": true
          },
          "isLive": {
            "type": "boolean",
            "description": "Open to seekers. Providers may register in an area before it opens, so this is a flag rather than a filter — the seeker-facing screens honour it, signup does not."
          }
        },
        "required": [
          "id",
          "cityId",
          "name",
          "lat",
          "lng",
          "isLive"
        ]
      },
      "ServiceCategoryRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Bharatanatyam"
          },
          "group": {
            "type": "string",
            "example": "dance",
            "description": "One of the eight taxonomy groups. Drives the colour a category renders in."
          }
        },
        "required": [
          "id",
          "name",
          "group"
        ]
      },
      "ProviderCategoryRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Dance Teacher"
          },
          "providerType": {
            "type": "string",
            "enum": [
              "individual",
              "institution"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "providerType"
        ]
      },
      "TeachingPlaceRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "individual_classes",
            "description": "A short text id, not a uuid."
          },
          "label": {
            "type": "string",
            "example": "One-to-one"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "sortOrder"
        ]
      },
      "ReferenceDto": {
        "type": "object",
        "properties": {
          "cities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityRefDto"
            }
          },
          "areas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AreaRefDto"
            }
          },
          "serviceCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceCategoryRefDto"
            }
          },
          "providerCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderCategoryRefDto"
            }
          },
          "teachingPlaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeachingPlaceRefDto"
            }
          }
        },
        "required": [
          "cities",
          "areas",
          "serviceCategories",
          "providerCategories",
          "teachingPlaces"
        ]
      },
      "CoachSuggestionDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "object",
            "additionalProperties": true,
            "description": "A row as search_providers() returns it, passed through unchanged."
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "description": "Why the model placed this coach here. Null when the list was not ranked."
          }
        },
        "required": [
          "provider",
          "reason"
        ]
      },
      "CoachSuggestionsDto": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoachSuggestionDto"
            }
          },
          "ranked": {
            "type": "boolean",
            "description": "False when the list is in plain distance order."
          },
          "cached": {
            "type": "boolean",
            "description": "True when served from the stored ranking."
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_a_seeker",
              "no_requirement",
              "no_origin",
              "nothing_nearby"
            ],
            "description": "Why there is nothing to show; absent when there is. The caller renders these very differently — 'no_requirement' is an invitation to state one, 'not_a_seeker' is not."
          }
        },
        "required": [
          "suggestions",
          "ranked"
        ]
      },
      "StudentSuggestionsQueryDto": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "format": "uuid",
            "description": "The coach's own listing. Must belong to them."
          },
          "serviceCategoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "areaId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "radiusKm": {
            "type": "number",
            "minimum": 1,
            "maximum": 200,
            "default": 15
          }
        },
        "required": [
          "providerId"
        ]
      },
      "StudentSuggestionDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "seeker:6f1c...",
            "description": "\"kind:id\" of a demand row."
          },
          "reason": {
            "type": "string",
            "description": "Why the model placed it here."
          }
        },
        "required": [
          "key",
          "reason"
        ]
      },
      "StudentSuggestionsDto": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudentSuggestionDto"
            }
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_a_provider",
              "no_demand"
            ],
            "description": "Why there is nothing to rank. 'no_demand' also covers too few untouched rows to be worth a model call — the caller keeps showing its own unranked list either way."
          }
        },
        "required": [
          "suggestions"
        ]
      }
    }
  }
}