<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Everything this app shows comes from api.aspire91.com. Flutter only
         declares this for debug and profile builds, so a release build without
         it fails on every screen at once. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- "Use my location" on the profile and on search. Coarse only: results
         are sorted from a neighbourhood, not a doorstep, so fine location
         would be precision nobody needs and a permission prompt that asks for
         more than the feature does. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 13+'s runtime permission for push — see push.dart's
         requestPermission(). Below 13 this is granted at install and the
         request is a no-op. Declared explicitly rather than left to
         firebase_messaging's own merged manifest, so it is not silently
         missing if that ever changes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Where an OTP magic link or a Google OAuth round trip returns.
                 ${applicationId} is an AGP built-in placeholder, so this is
                 already "com.aspire91.app" for seeker and
                 "com.aspire91.app.coach" for provider without a manifest
                 per flavor — see Flavor.authRedirectUrl. A custom scheme, not
                 an HTTPS App Link, so it needs no assetlinks.json and no
                 verification; it still needs adding to Supabase's redirect
                 URL allowlist (Authentication -> URL Configuration) before it
                 does anything. See README §7/§10.4. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${applicationId}" android:host="login-callback"/>
            </intent-filter>
            <!-- The backend's push envelope (api/src/notify/push.service.ts)
                 sends android.notification.click_action:
                 "FLUTTER_NOTIFICATION_CLICK" on every notification, so a tap
                 opens the app at the right screen instead of the home tab.
                 Without this intent-filter to match it, Android has nothing
                 telling it this Activity is what that click_action should
                 launch — the notification would still show, but tapping it
                 would not reliably hand the payload to
                 FirebaseMessaging.onMessageOpenedApp/getInitialMessage(),
                 which is exactly the "message arrived but nothing happens
                 when I tap it" shape of bug. -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The channel a background/terminated notification is shown on —
             must match the id push.dart's AndroidNotificationDetails uses
             for the foreground case ('messages'), so a notification looks
             and behaves the same regardless of which state delivered it. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher. Android 11 hides other apps unless they are declared
             here, and without these canLaunchUrl answers false for a number
             the phone can plainly dial. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
